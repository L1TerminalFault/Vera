    bool isPrimary = false;
};

constexpr size_t MAX_KEY_REPEATS = 32;
constexpr size_t MAX_WAYLAND_OUTPUTS = 16;
constexpr size_t MAX_WAYLAND_WINDOWS = 64;

struct KeyRepeatStateWayland {
    uint32_t key = 0;
    uint32_t scanCode = 0;
    VeraKey veraKey = VeraKey::Unknown;
    uint64_t nextRepeatMs = 0;  // Monotonic time in milliseconds
};

static inline uint64_t getMonotonicTimeMs() {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return static_cast<uint64_t>(ts.tv_sec) * 1000ULL +
           static_cast<uint64_t>(ts.tv_nsec) / 1000000ULL;
}

struct JoystickDeviceWayland {
    int fd = -1;
    char devicePath[256] = {};
    VeraJoystickState state{};
};

struct WindowSurfacePair {
    wl_surface* surface = nullptr;
    WaylandWindow* window = nullptr;
};

struct WaylandContext {
    wl_display* display = nullptr;
    wl_registry* registry = nullptr;
    wl_compositor* compositor = nullptr;
    wl_shm* shm = nullptr;
    wl_seat* seat = nullptr;
    xdg_wm_base* wmBase = nullptr;
    wl_data_device_manager* dataDeviceManager = nullptr;
    zxdg_output_v1* xdgOutputManager = nullptr;

    zxdg_decoration_manager_v1* decorationManager = nullptr;
    zwp_pointer_constraints_v1* pointerConstraints = nullptr;
    zwp_relative_pointer_manager_v1* relativePointerManager = nullptr;

    wl_pointer* pointer = nullptr;
    wl_keyboard* keyboard = nullptr;
    wl_data_device* dataDevice = nullptr;
    uint32_t keyRepeatRate = 0;
    uint32_t keyRepeatDelay = 0;

    // Flat key repeat tracking (N-key rollover rarely exceeds 32 simultaneous
    // keys)
    KeyRepeatStateWayland pressedKeys[MAX_KEY_REPEATS] = {};
    size_t pressedKeyCount = 0;

    xkb_context* xkbContext = nullptr;
    xkb_keymap* xkbKeymap = nullptr;
    xkb_state* xkbState = nullptr;

    // Fixed array for multi-monitor output management
    WaylandOutputInfo outputs[MAX_WAYLAND_OUTPUTS] = {};
    size_t outputCount = 0;

    // Flat O(N) surface-to-window lookup table
    WindowSurfacePair windowsBySurface[MAX_WAYLAND_WINDOWS] = {};
    size_t windowCount = 0;

    wl_surface* pointerFocusSurface = nullptr;
    wl_surface* keyboardFocusSurface = nullptr;
    WaylandWindow* focusedWindow = nullptr;

    uint32_t lastPointerEnterSerial = 0;
    uint32_t lastPointerButtonSerial = 0;
    uint32_t pointerSerial = 0;

    wl_data_offer* activeClipboardOffer = nullptr;
    wl_cursor_theme* cursorTheme = nullptr;
    wl_surface* cursorSurface = nullptr;

    wl_cursor* currentCursor = nullptr;
    uint32_t currentFrameIndex = 0;
    wl_event_source* cursorAnimationTimer = nullptr;
    bool isCursorAnimating = false;
    uint64_t lastFrameTimeMs = 0;  // Monotonic timestamp in ms
    VeraCursorShape pendingShape = VeraCursorShape::Arrow;

    double pointerX = 0.0;
    double pointerY = 0.0;
    bool quitRequested = false;

    zwp_locked_pointer_v1* activeLockedPointer = nullptr;
    zwp_confined_pointer_v1* activeConfinedPointer = nullptr;
    zwp_relative_pointer_v1* activeRelativePointer = nullptr;
    bool keyStates[static_cast<size_t>(VeraKey::Count)] = {false};
    bool mouseButtonStates[static_cast<size_t>(VeraMouseButton::Count)] = {
        false};

    nostd::Vector<JoystickDeviceWayland> joysticks =
        nostd::Vector<JoystickDeviceWayland>(16);

    bool isFullscreen = false;
    bool isMaximized = false;
    bool isSuspended = false;

    uint64_t allocateHandle() {
        static uint64_t sHandleCounter = 0;
        return ++sHandleCounter;
    }

    // --- Helper Methods to Replace Map Lookups ---

    WaylandWindow* findWindowBySurface(wl_surface* surface) const {
        if (!surface) return nullptr;
        for (size_t i = 0; i < windowCount; ++i) {
            if (windowsBySurface[i].surface == surface) {
                return windowsBySurface[i].window;
            }
        }
        return nullptr;
    }

    void registerWindowSurface(wl_surface* surface, WaylandWindow* window) {
        if (!surface || windowCount >= MAX_WAYLAND_WINDOWS) return;
        // Update existing if present
        for (size_t i = 0; i < windowCount; ++i) {
            if (windowsBySurface[i].surface == surface) {
                windowsBySurface[i].window = window;
                return;
            }
        }
        windowsBySurface[windowCount++] = {surface, window};
    }

    void unregisterWindowSurface(wl_surface* surface) {
        for (size_t i = 0; i < windowCount; ++i) {
            if (windowsBySurface[i].surface == surface) {
                windowsBySurface[i] = windowsBySurface[windowCount - 1];
                windowsBySurface[--windowCount] = {};
                return;
            }
        }
    }
};

